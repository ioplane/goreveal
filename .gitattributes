# Normalize line endings on checkin, check out native.
* text=auto eol=lf

*.go text eol=lf diff=golang
*.md text eol=lf
*.py text eol=lf diff=python
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.json text eol=lf
Makefile text eol=lf
Containerfile* text eol=lf

# Never normalize binary corpus artifacts.
*.bin binary
*.exe binary
*.so binary
*.dylib binary
*.db binary
corpus/**/fixture.bin binary
corpus/**/*.golden -text -diff

# Generated / vendored content: keep out of language stats and diffs.
go.sum linguist-generated=true
tests/snapshots/**/*.json linguist-generated=true
docs/** linguist-documentation=true
plugins/** linguist-language=Python
