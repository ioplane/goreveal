# syntax=docker/dockerfile:1
#
# GoREveal development container.
#
# Base image is digest-pinned. Refresh it deliberately: read the digest from
# `skopeo inspect docker://docker.io/library/golang:1.26-trixie` and update both
# the tag and the digest in the same commit.
FROM docker.io/library/golang:1.26-trixie@sha256:4ee9ffa999b4583ce281939cdff828763083610292f252279a0cee77473bd9a7 AS dev

LABEL org.opencontainers.image.title="GoREveal Dev Container" \
      org.opencontainers.image.description="Podman-first development environment for GoREveal" \
      org.opencontainers.image.source="https://github.com/ioplane/goreveal" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="ioplane"

# Tool versions are pinned so the container, CI, and local runs agree.
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GORELEASER_VERSION=v2.17.1
ARG SYFT_VERSION=v1.50.0
ARG COSIGN_VERSION=v3.1.2
ARG UV_VERSION=0.12.0
ARG PYTHON_VERSION=3.14

ENV GOFLAGS=-buildvcs=false \
    CGO_ENABLED=0 \
    UV_PYTHON=${PYTHON_VERSION} \
    UV_LINK_MODE=copy \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    PATH=/usr/local/go/bin:/go/bin:/usr/local/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      file \
      git \
      jq \
      make \
      procps \
      ripgrep \
      shellcheck \
      tzdata \
      unzip \
    && rm -rf /var/lib/apt/lists/*

# uv owns the Python toolchain: it provisions the interpreter itself, so the
# container is not bound to whatever Python the base distro happens to ship.
RUN curl -fsSL "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv python install "${PYTHON_VERSION}" \
    && uv tool install yq \
    && uv --version \
    && uv python list --only-installed

RUN go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    && go install "github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION}" \
    && go install "github.com/anchore/syft/cmd/syft@${SYFT_VERSION}" \
    && go install "github.com/sigstore/cosign/v3/cmd/cosign@${COSIGN_VERSION}" \
    && go install golang.org/x/perf/cmd/benchstat@latest \
    && go install golang.org/x/vuln/cmd/govulncheck@latest \
    && go install gotest.tools/gotestsum@latest \
    && go install mvdan.cc/garble@latest \
    && go clean -cache -modcache

WORKDIR /workspace
VOLUME /workspace

CMD ["sleep", "infinity"]
